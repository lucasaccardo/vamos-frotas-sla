AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1
PASSWORD_RESET_TIMEOUT=3600

TERMOS_VERSAO=2026-05

SECURITY_LOG_FILE=/app/logs/security_audit.log

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

